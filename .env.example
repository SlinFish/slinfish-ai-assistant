PORT=3000
# Unset INQUIRY_DB_PATH keeps inquiry submission validation-only.
# Optional absolute path in an existing private directory OUTSIDE the checkout:
# INQUIRY_DB_PATH=/absolute/private/directory/inquiries.sqlite
# No API keys or paid services are required. .env files are not auto-loaded.

# Grounded chat defaults to offline demo, even if a Gemini key exists.
AI_PROVIDER=demo
# Opt-in only: AI_PROVIDER=gemini requires a private server-side GEMINI_API_KEY.
# Supply the key privately through the process environment; never commit it.
# Optional pinned model; other model IDs fail startup:
# AI_MODEL=gemini-3.8-flash
# AI_TIMEOUT_MS=8000
# AI_DIAGNOSTICS=1 enables sanitized local failure metadata only.
